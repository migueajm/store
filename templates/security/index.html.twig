{% extends 'base.html.twig' %}

{% block title %}Bienvenido{% endblock %}

{% block body %}
<div class="container-fluid py-5 bg-light">
    <header class="text-center mb-5">
        <h1 class="display-4 fw-bold">Bienvenido a @migueajm Store</h1>
        <p class="lead text-muted">La mejor tienda para tus necesidades diarias</p>
    </header>
    <div class="row align-items-center">
        <div class="col-md-6 text-center">
            {% include "components/icon.html.twig" %}
        </div>
        <div class="col-md-6">
            <h2 class="fw-bold">Sobre Nosotros</h2>
            <p class="text-muted fs-5">
                En <strong>@migueajm Store</strong>, nos dedicamos a ofrecerte los mejores productos a los mejores precios.
                Descubre una amplia variedad de artículos esenciales para tu día a día, con la comodidad de hacer todo desde casa.
            </p>
            <div class="d-flex flex-column flex-md-row gap-3 mt-4">
                <a href="{{ path('app_authentication_sign_in') }}" class="btn btn-success btn-lg">Inicia Sesión</a>
                <a href="#productos" class="btn btn-outline-secondary btn-lg">Explorar Productos</a>
            </div>
        </div>
    </div>
</div>
<section class="bg-white">

    <div class="container py-5 bg-white" id="productos">
        <h2 class="text-center fw-bold mb-4">Nuestros Productos Destacados</h2>
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <img src="{{ asset('resources/image/product1.png') }}" class="card-img-top" alt="Producto 1">
                    <div class="card-body text-center">
                        <h5 class="card-title">Producto 1</h5>
                        <p class="card-text text-muted">Descripción breve del producto.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <img src="{{ asset('resources/image/product2.png') }}" class="card-img-top" alt="Producto 2">
                    <div class="card-body text-center">
                        <h5 class="card-title">Producto 2</h5>
                        <p class="card-text text-muted">Descripción breve del producto.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <img src="{{ asset('resources/image/product3.png') }}" class="card-img-top" alt="Producto 3">
                    <div class="card-body text-center">
                        <h5 class="card-title">Producto 3</h5>
                        <p class="card-text text-muted">Descripción breve del producto.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
