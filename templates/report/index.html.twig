{% extends 'dashboard/base.html.twig' %}

{% block title %}Visualización y Descarga de Reportes{% endblock %}

{% block dashboardBody %}
    <h2>Visualización y Descarga de Reportes</h2>
    <div class="mb-4">
        <form method="get" {# action="{{ path('report_generate') }}" #}>
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <label for="startDate" class="col-form-label">Fecha de Inicio</label>
                </div>
                <div class="col-auto">
                    <input type="date" id="startDate" name="startDate" class="form-control">
                </div>
                <div class="col-auto">
                    <label for="endDate" class="col-form-label">Fecha de Fin</label>
                </div>
                <div class="col-auto">
                    <input type="date" id="endDate" name="endDate" class="form-control">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Generar Reporte</button>
                </div>
            </div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID Reporte</th>
                    <th>Nombre</th>
                    <th>Fecha Generación</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                {% for report in reports ?? [] %}
                    <tr>
                        <td>{{ report.id }}</td>
                        <td>{{ report.name }}</td>
                        <td>{{ report.generated_at|date('d/m/Y H:i') }}</td>
                        <td>
                            <a href="{{ path('report_view', {id: report.id}) }}" class="btn btn-sm btn-primary">Ver</a>
                            <a href="{{ path('report_download', {id: report.id}) }}" class="btn btn-sm btn-success">Descargar</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center">No hay reportes disponibles.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
