<div class="table-responsive">
	<table class="table table-striped" id="{{table.id ?? 'table-id'}}">
		{% if table.head is defined %}
			<thead>
				<tr>
					{% for head in table.head %}
						<th>{{head}}</th>
					{% endfor %}
				</tr>
			</thead>
		{% endif %}
		{% if table.body is defined %}
			<tr>
				<td colspan="{{table.count ?? ''}}" class="text-center">{{table.body}}</td>
			</tr>
		{% endif %}
	</table>
</div>