{% extends "dashboard/base.html.twig" %}

{% block dashboardBody %}
	<h2>{{title ?? 'Dashboard'}}</h2>
	<p>{{description ?? 'description'}}</p>
	<div class="row g-3">
			{% for card in miniCard %}
					<div class="col-md-3">
							{% include "components/card.html.twig" %}
					</div>
			{% endfor %}
	</div>
	<div class="row mt-4">
			{% for card in cards %}
					<div class="col-md-6">
							{% include "components/card.html.twig" %}
					</div>
			{% endfor %}
	</div>
{% endblock %}